# Copy to .env and fill in real values. .env is git-ignored; never commit it.
#
# The server refuses to start with NODE_ENV=production while these are unset
# or still the published development defaults.

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Admin panel login (minimum 12 characters)
ADMIN_USER=admin
ADMIN_PASS=

# Optional
# PORT=8787
# DB_FILE=server/data/khyeast.db

# Canonical public origin, used to build payment-gateway callback URLs.
# Required in production so the callback cannot be redirected via the Host header.
PUBLIC_ORIGIN=https://khuzestanyeast-co.com

# Optional: comma-separated Host values accepted when PUBLIC_ORIGIN is unset.
# TRUSTED_HOSTS=khuzestanyeast-co.com,www.khuzestanyeast-co.com
