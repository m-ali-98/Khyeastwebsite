# Copy to .env and fill in real values. .env is git-ignored; never commit it.
#
# The server refuses to start with NODE_ENV=production while these are unset
# or still the published development defaults.

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This also keys rate-limit bucket HMACs; every Passenger worker must use the
# same stable value. Rotating it intentionally starts fresh limiter buckets.
ADMIN_SECRET=

# Admin panel login (minimum 12 characters)
ADMIN_USER=admin
ADMIN_PASS=

# Optional
# PORT=8787
# DB_FILE=server/data/khyeast.db

# Explicit schema migration command only (`npm run db:migrate`). Application
# startup never runs migrations. The default backup directory is a sibling of
# DATA_DIR, with a 1 GiB additional free-space reserve and three snapshot/fence
# attempts. Override these only for the persistent production filesystem.
# MIGRATION_BACKUP_DIR=/var/lib/khyeast/migration-backups
# MIGRATION_MIN_FREE_BYTES=1073741824
# MIGRATION_ATTEMPTS=3

# Canonical public origin for payment callbacks, search metadata, sitemap URLs,
# secure-cookie detection, and HTTP/host redirects. Required in production.
PUBLIC_ORIGIN=https://khuzestanyeast-co.com

# Optional: comma-separated trusted aliases. They also participate in the
# guarded HTTPS fallback when a trusted proxy omits X-Forwarded-Proto.
# TRUSTED_HOSTS=khuzestanyeast-co.com,www.khuzestanyeast-co.com

# Apache/Passenger should forward: X-Forwarded-Proto: https
# If it does not, production infers HTTPS only when PUBLIC_ORIGIN is https,
# Host matches PUBLIC_ORIGIN/TRUSTED_HOSTS, and the Node peer is trusted below.
# IMPORTANT: the port-80 vhost must redirect to HTTPS before proxying to Node.
# If :80 must be proxied, it must set X-Forwarded-Proto: http; never omit it.
# Express proxy trust. The safe default trusts only loopback/link-local/private
# proxies, which fits Apache/Passenger on most cPanel hosts. Override only when
# the Admin → Security diagnostic shows the forwarded visitor IP is unresolved.
# Accepts false, a hop count (for example 1), or an Express proxy-addr value.
# Never use true unless direct access to Node is impossible.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Initial rate ceilings can be overridden here; after an admin saves the
# Security panel, its database settings become authoritative. The whole limiter
# can also be disabled temporarily from that panel.
# RATE_LIMITS_ENABLED=true
# RL_MAX_MESSAGE=5
# RL_MAX_COMMENT=5
# RL_MAX_ORDER=12
# RL_MAX_PAYMENT_RETRY=5
# RL_MAX_PAYMENT_CALLBACK=12
# RL_MAX_ADMIN_LOGIN=8
# RL_MAX_OTP_PHONE=5
# RL_MAX_OTP_IP=30
# RL_MAX_CUSTOMER_LOGIN=10
# RL_MAX_CUSTOMER_LOGIN_IP=30
# RL_MAX_REGISTER=40

# Optional ownership tokens copied exactly from the corresponding webmaster
# portal. When set, they are rendered into every route-specific HTML response.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Optional build-only override for a static dist/ deployment. Normally the
# canonical PUBLIC_ORIGIN above is used for sitemap and prerendered pages.
# SEO_ORIGIN=https://khuzestanyeast-co.com
