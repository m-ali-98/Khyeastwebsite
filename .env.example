# Copy to .env and fill in real values. .env is git-ignored; never commit it.
#
# The server refuses to start with NODE_ENV=production while these are unset
# or still the published development defaults.

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Admin panel login (minimum 12 characters)
ADMIN_USER=admin
ADMIN_PASS=

# Optional
# PORT=8787
# DB_FILE=server/data/khyeast.db

# Canonical public origin for payment callbacks, search metadata, sitemap URLs,
# and HTTP/host redirects. Required in production to prevent Host-header abuse.
PUBLIC_ORIGIN=https://khuzestanyeast-co.com

# Optional: comma-separated Host values accepted when PUBLIC_ORIGIN is unset.
# TRUSTED_HOSTS=khuzestanyeast-co.com,www.khuzestanyeast-co.com

# Optional ownership tokens copied exactly from the corresponding webmaster
# portal. When set, they are rendered into every route-specific HTML response.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Optional build-only override for a static dist/ deployment. Normally the
# canonical PUBLIC_ORIGIN above is used for sitemap and prerendered pages.
# SEO_ORIGIN=https://khuzestanyeast-co.com
