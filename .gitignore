# Dependencies and generated builds
node_modules/
dist/
dist-ssr/
coverage/
.nyc_output/
.vite/
.cache/
.npm/
*.tsbuildinfo

# Browser-test and downloaded CI artefacts
# Reviewed baselines in e2e/visual.spec.js-snapshots/ stay tracked.
.e2e-data/
test-results/
playwright-report/
blob-report/
.playwright/
.ci/
playwright-artifacts/

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.pid.lock
.eslintcache
.stylelintcache
*.tmp
*.swp
*~
tmp/
temp/
image-search/

# Local editor and operating-system files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# Local-only configuration and secrets
*.local
.env
.env.*
!.env.example

# Runtime uploads and mutable application data
server/uploads/*
!server/uploads/.gitkeep
server/data/messages.json
server/data/shop.json
server/data/*.db
server/data/*.db-wal
server/data/*.db-shm
server/data/*.db-journal

# Legacy CMS JSON is a one-time migration input only; never track mutable state.
server/data/content.json
server/data/content.json.*
