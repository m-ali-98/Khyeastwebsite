#!/usr/bin/env bash
# Replicate the newest completed local archive to an encrypted Restic
# repository. Configure repository/provider credentials only in the root-owned
# EnvironmentFile used by khyeast-offsite.service; never expose them to Node.
set -Eeuo pipefail
umask 077

BACKUP_DEST=${BACKUP_DEST:-/var/backups/khyeast}
RESTIC_TAG=${RESTIC_TAG:-khyeast-validated-archive}
RESTIC_KEEP_DAILY=${RESTIC_KEEP_DAILY:-14}
RESTIC_KEEP_WEEKLY=${RESTIC_KEEP_WEEKLY:-8}
RESTIC_KEEP_MONTHLY=${RESTIC_KEEP_MONTHLY:-12}
MAX_LOCAL_BACKUP_AGE_HOURS=${MAX_LOCAL_BACKUP_AGE_HOURS:-30}

fail() {
  printf 'replicate-khyeast-restic: %s\n' "$*" >&2
  exit 1
}

for command in restic sha256sum flock find sort stat date; do
  command -v "$command" >/dev/null 2>&1 || fail "required command is missing: $command"
done
[[ -n ${RESTIC_REPOSITORY:-} ]] || fail 'RESTIC_REPOSITORY is not configured'
[[ -n ${RESTIC_PASSWORD_FILE:-} && -r $RESTIC_PASSWORD_FILE ]] || fail 'RESTIC_PASSWORD_FILE is missing or unreadable'
for value in "$RESTIC_KEEP_DAILY" "$RESTIC_KEEP_WEEKLY" "$RESTIC_KEEP_MONTHLY"; do
  [[ $value =~ ^(0|[1-9][0-9]*)$ ]] || fail 'Restic retention values must be non-negative integers'
done
(( RESTIC_KEEP_DAILY >= 1 )) || fail 'RESTIC_KEEP_DAILY must retain at least one recovery point'
[[ $MAX_LOCAL_BACKUP_AGE_HOURS =~ ^[0-9]+$ ]] && (( MAX_LOCAL_BACKUP_AGE_HOURS >= 1 )) || fail 'MAX_LOCAL_BACKUP_AGE_HOURS must be a positive integer'
[[ -d $BACKUP_DEST ]] || fail "local backup directory not found: $BACKUP_DEST"

exec 9>/run/lock/khyeast-offsite.lock
flock -n 9 || fail 'another offsite replication is already running'

mapfile -t candidates < <(
  find "$BACKUP_DEST" -maxdepth 1 -type f -name 'khyeast-*.tar' -printf '%T@ %p\n' | sort -nr
)
[[ ${#candidates[@]} -gt 0 ]] || fail 'no completed local archive was found'
archive=${candidates[0]#* }
checksum=$archive.sha256
[[ -f $checksum ]] || fail "checksum sidecar not found: $checksum"
archive_age_seconds=$(( $(date +%s) - $(stat -c %Y "$archive") ))
(( archive_age_seconds >= 0 )) || fail 'newest local archive has a future timestamp; check the system clock'
(( archive_age_seconds <= MAX_LOCAL_BACKUP_AGE_HOURS * 60 * 60 )) || fail "newest local archive is older than ${MAX_LOCAL_BACKUP_AGE_HOURS} hours"
verify_local_archive() {
  (
    cd "$(dirname "$archive")"
    sha256sum -c "$(basename "$checksum")"
  )
}
verify_local_archive

# Restic encrypts and authenticates repository data. Recheck local immutability
# after transfer, then check repository metadata before applying remote policy.
restic backup --tag "$RESTIC_TAG" -- "$archive" "$checksum"
verify_local_archive
restic check
restic forget \
  --tag "$RESTIC_TAG" \
  --group-by host,tags \
  --keep-daily "$RESTIC_KEEP_DAILY" \
  --keep-weekly "$RESTIC_KEEP_WEEKLY" \
  --keep-monthly "$RESTIC_KEEP_MONTHLY" \
  --prune
restic cache --cleanup

printf 'replicate-khyeast-restic: verified offsite snapshot for %s\n' "$(basename "$archive")"
