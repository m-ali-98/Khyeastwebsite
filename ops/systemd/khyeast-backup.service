[Unit]
Description=Create a validated online Khyeast backup
After=local-fs.target

[Service]
Type=oneshot
TimeoutStartSec=6h
ExecStart=/usr/local/sbin/backup-khyeast
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/khyeast /srv/khyeast
ReadWritePaths=/var/backups/khyeast /run/lock
