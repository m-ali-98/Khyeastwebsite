[Unit]
Description=Check and prune Khyeast Restic backups from a trusted maintenance host
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/khyeast/restic-maintenance.env

[Service]
Type=oneshot
TimeoutStartSec=12h
EnvironmentFile=/etc/khyeast/restic-maintenance.env
Environment=RESTIC_CACHE_DIR=/var/cache/khyeast-restic-maintenance
ExecStart=/usr/local/sbin/maintain-khyeast-restic
UMask=0077
Nice=10
IOSchedulingClass=idle
CacheDirectory=khyeast-restic-maintenance
CacheDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/cache/khyeast-restic-maintenance /run/lock
