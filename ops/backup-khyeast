#!/usr/bin/env bash
# Validated, staged backup for the Khyeast single-host deployment.
#
# While the app is active, SQLite's backup API supplies a transactionally
# consistent online snapshot. If systemd confirms the app is inactive, the
# stable database (plus WAL sidecars after an unclean stop) is first copied to
# writable staging so a read-only source mount cannot make emergency backups
# fail. Two upload passes produce a conservative superset. Quarantine remains a
# 30-day local recycle bin, and multipart .incoming files are transient; both
# are intentionally excluded from disaster recovery.
set -Eeuo pipefail
umask 077

DEST=${BACKUP_DEST:-/var/backups/khyeast}
STATE_ROOT=${KHYEAST_STATE_ROOT:-/var/lib/khyeast}
DATA_DIR=${DATA_DIR:-$STATE_ROOT/data}
UPLOAD_DIR=${UPLOAD_DIR:-$STATE_ROOT/uploads}
DB_FILE=${DB_FILE:-$DATA_DIR/khyeast.db}
RELEASE_DIR=${RELEASE_DIR:-/srv/khyeast/current}
APP_SERVICE=${APP_SERVICE:-khyeast.service}
LOCAL_RETENTION_DAYS=${LOCAL_RETENTION_DAYS:-14}
BACKUP_MIN_FREE_BYTES=${BACKUP_MIN_FREE_BYTES:-1073741824}
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
ARCHIVE=$DEST/khyeast-$STAMP.tar
ARCHIVE_TMP=$DEST/.khyeast-$STAMP-$$.tar.tmp
CHECKSUM=$ARCHIVE.sha256
CHECKSUM_TMP=$DEST/.khyeast-$STAMP-$$.sha256.tmp
STAGE=

fail() {
  printf 'backup-khyeast: %s\n' "$*" >&2
  exit 1
}

cleanup() {
  if [[ -n ${STAGE:-} ]]; then rm -rf -- "$STAGE"; fi
  rm -f -- "$ARCHIVE_TMP" "$CHECKSUM_TMP"
}
trap cleanup EXIT

for command in sqlite3 rsync node tar sha256sum flock nice ionice cp cmp grep find install mktemp stat sync du df awk systemctl; do
  command -v "$command" >/dev/null 2>&1 || fail "required command is missing: $command"
done
[[ $LOCAL_RETENTION_DAYS =~ ^(0|[1-9][0-9]*)$ ]] || fail 'LOCAL_RETENTION_DAYS must be a non-negative integer'
[[ $BACKUP_MIN_FREE_BYTES =~ ^(0|[1-9][0-9]*)$ ]] || fail 'BACKUP_MIN_FREE_BYTES must be a non-negative integer'
[[ -n $APP_SERVICE && $APP_SERVICE != *$'\n'* ]] || fail 'APP_SERVICE is invalid'
[[ -f $DB_FILE ]] || fail "database not found: $DB_FILE"
[[ -d $UPLOAD_DIR ]] || fail "upload directory not found: $UPLOAD_DIR"

install -d -m 0700 "$DEST"
exec 9>"$DEST/.backup.lock"
flock -n 9 || fail 'another backup is already running'
[[ ! -e $ARCHIVE && ! -e $CHECKSUM ]] || fail "archive already exists for timestamp $STAMP"

# The stage and uncompressed tar coexist; a stopped database also needs an
# untouched reference, a working copy and a snapshot. Budget for the larger
# of those cases plus reserve. This is a preflight, not a filesystem quota.
upload_bytes=$(du -sb --exclude='.quarantine' --exclude='.incoming' -- "$UPLOAD_DIR" | awk 'NR == 1 { print $1 }')
[[ $upload_bytes =~ ^[0-9]+$ ]] || fail 'could not measure live upload size'
database_bytes=$(stat -c %s "$DB_FILE")
for sidecar in "$DB_FILE-wal" "$DB_FILE-shm"; do
  if [[ -f $sidecar ]]; then database_bytes=$(( database_bytes + $(stat -c %s "$sidecar") )); fi
done
required_free=$(( upload_bytes * 2 + database_bytes * 3 + BACKUP_MIN_FREE_BYTES ))
available_free=$(df -PB1 "$DEST" | awk 'NR == 2 { print $4 }')
[[ $available_free =~ ^[0-9]+$ ]] || fail "could not read free space for $DEST"
(( available_free >= required_free )) || fail \
  "insufficient free space on backup filesystem: need ${required_free} bytes, have ${available_free}"

STAGE=$(mktemp -d "$DEST/.stage-$STAMP.XXXXXX")
install -d -m 0700 "$STAGE/khyeast/data" "$STAGE/khyeast/uploads"

# Paths are interpolated into sqlite3's dot-command language below. The normal
# production paths contain neither character; reject surprising configuration
# rather than constructing an ambiguous command.
case "$STAGE" in
  *"'"*|*$'\n'*) fail 'backup path contains a character unsafe for sqlite3 .backup' ;;
esac

content_revision() {
  sqlite3 -batch -noheader -readonly "$1" <<'SQL'
.bail on
.timeout 10000
PRAGMA query_only = ON;
WITH expected(section, json_kind) AS (
  VALUES
    ('texts', 'object'),
    ('media', 'object'),
    ('links', 'object'),
    ('collections', 'object'),
    ('brands', 'array'),
    ('products', 'array'),
    ('posts', 'array'),
    ('i18n', 'object'),
    ('gallery', 'array')
), meta AS (
  SELECT revision FROM content_meta WHERE id = 1
)
SELECT CAST(meta.revision AS TEXT)
  FROM meta
 WHERE meta.revision >= 1
   AND (SELECT COUNT(*) FROM content_meta) = 1
   AND (SELECT application_id FROM pragma_application_id) = 1263032645
   AND (SELECT user_version FROM pragma_user_version) = 1
   AND (SELECT CASE WHEN json_valid(value) THEN json_type(value) END
          FROM settings WHERE key = 'installation.initializedAt') = 'text'
   AND (SELECT CASE WHEN json_valid(value) THEN json_type(value) END
          FROM settings WHERE key = 'shop.display') = 'object'
   AND (SELECT CASE WHEN json_valid(value) THEN json_type(value) END
          FROM settings WHERE key = 'shop.payment') = 'object'
   AND (
     SELECT COUNT(*)
       FROM expected
       JOIN content_sections USING (section)
      WHERE CASE
              WHEN json_valid(content_sections.value_json)
                THEN json_type(content_sections.value_json)
              ELSE NULL
            END = expected.json_kind
        AND content_sections.revision BETWEEN 1 AND meta.revision
   ) = 9;
SQL
}

# First pass captures files that could be unreferenced and moved to quarantine
# after this point. In-progress multipart bodies are never recovery data.
# Never use --delete: a conservative extra live file is harmless, while deleting
# a file named by the metadata snapshot would break a restore.
rsync -a --exclude='/.quarantine/' --exclude='/.incoming/' -- "$UPLOAD_DIR/" "$STAGE/khyeast/uploads/"

app_service_state() {
  local state
  state=$(systemctl is-active "$APP_SERVICE" 2>/dev/null || true)
  case "$state" in
    active|activating|reloading) printf 'active\n' ;;
    inactive|failed) printf 'inactive\n' ;;
    deactivating) printf 'transitioning\n' ;;
    *) printf 'unknown\n' ;;
  esac
}

# Compare the untouched reference copy with the source both before and after
# validating a stopped-service snapshot. A service restart, changed sidecar,
# or changed database must fail closed; never open the read-only source with
# SQLite when the service is stopped.
offline_source_is_stable() {
  local reference=$1 suffix source_file copied_file
  [[ $(app_service_state) == inactive ]] || return 1
  for suffix in '' '-wal' '-shm'; do
    source_file=$DB_FILE$suffix
    copied_file=$reference/khyeast.db$suffix
    if [[ -f $source_file || -f $copied_file ]]; then
      [[ -f $source_file && -f $copied_file ]] || return 1
      cmp -s -- "$source_file" "$copied_file" || return 1
    fi
  done
}

snapshot_ok=0
database_snapshot_mode=
for attempt in 1 2 3; do
  database=$STAGE/khyeast.db.pending
  offline_source=$STAGE/offline-db-source
  offline_reference=$STAGE/offline-db-reference
  rm -rf -- "$database" "$offline_source" "$offline_reference"

  database_copied=0
  candidate_mode=
  before_revision=
  service_state=$(app_service_state)
  if [[ $service_state == active ]]; then
    before_revision=$(content_revision "$DB_FILE" 2>/dev/null || true)
    if [[ ! $before_revision =~ ^[1-9][0-9]*$ ]]; then
      printf 'backup-khyeast: authoritative SQLite content was unreadable on attempt %s; retrying\n' "$attempt" >&2
      sleep 1
      continue
    fi
  fi
  if [[ $service_state == active ]]; then
    if sqlite3 -readonly "$DB_FILE" <<SQL
.bail on
.timeout 10000
.backup '$database'
SQL
    then
      database_copied=1
      candidate_mode=online-sqlite-backup
    fi
  elif [[ $service_state == inactive ]]; then
    # The read-only systemd sandbox prevents SQLite from creating journal
    # sidecars beside a clean, stopped database. Copy the stable source first;
    # if a WAL survived an unclean stop, consolidate that copied set in staging.
    install -d -m 0700 "$offline_source" "$offline_reference"
    for suffix in '' '-wal' '-shm'; do
      source_file=$DB_FILE$suffix
      if [[ -f $source_file ]]; then
        install -m 0600 -- "$source_file" "$offline_reference/khyeast.db$suffix"
        cp -- "$offline_reference/khyeast.db$suffix" "$offline_source/khyeast.db$suffix"
      fi
    done

    if offline_source_is_stable "$offline_reference"; then
      if [[ -f $offline_source/khyeast.db-wal ]]; then
        if sqlite3 "$offline_source/khyeast.db" <<SQL
.bail on
.timeout 10000
.backup '$database'
SQL
        then
          database_copied=1
          candidate_mode=offline-wal-copy
        fi
      elif cp -- "$offline_source/khyeast.db" "$database"; then
        database_copied=1
        candidate_mode=offline-clean-copy
      fi
    fi
  elif [[ $service_state == transitioning ]]; then
    printf 'backup-khyeast: %s is stopping; retrying a stable snapshot\n' "$APP_SERVICE" >&2
  else
    fail "cannot determine whether $APP_SERVICE is active; refusing an unsafe database copy"
  fi

  if [[ $database_copied -ne 1 ]]; then
    printf 'backup-khyeast: SQLite backup attempt %s failed in %s service state; retrying\n' "$attempt" "$service_state" >&2
    sleep 1
    continue
  fi

  integrity=$(sqlite3 -batch -noheader "$database" 'PRAGMA integrity_check;') || integrity=''
  foreign_keys=$(sqlite3 -batch -noheader "$database" 'PRAGMA foreign_key_check;') || foreign_keys='check-failed'
  if [[ $integrity != ok || -n $foreign_keys ]]; then
    printf 'backup-khyeast: copied database failed integrity checks; retrying\n' >&2
    sleep 1
    continue
  fi

  snapshot_revision=$(content_revision "$database" 2>/dev/null || true)
  if [[ ! $snapshot_revision =~ ^[1-9][0-9]*$ ]]; then
    printf 'backup-khyeast: copied editorial content failed strict validation; retrying\n' >&2
    sleep 1
    continue
  fi
  if [[ $service_state == active ]]; then
    after_revision=$(content_revision "$DB_FILE" 2>/dev/null || true)
    if [[ ! $after_revision =~ ^[1-9][0-9]*$ || $before_revision != "$snapshot_revision" || $snapshot_revision != "$after_revision" ]]; then
      printf 'backup-khyeast: live editorial content changed or failed validation during snapshot attempt %s; retrying\n' "$attempt" >&2
      sleep 1
      continue
    fi
  elif ! offline_source_is_stable "$offline_reference"; then
    printf 'backup-khyeast: stopped-service database or service state changed during snapshot attempt %s; retrying\n' "$attempt" >&2
    sleep 1
    continue
  fi

  mv -- "$database" "$STAGE/khyeast/data/khyeast.db"
  content_revision_value=$snapshot_revision
  database_snapshot_mode=$candidate_mode
  snapshot_ok=1
  break
done
[[ $snapshot_ok -eq 1 ]] || fail 'could not obtain a stable validated SQLite snapshot after three attempts'
# The offline reference and work copy have served their stability check; only
# the validated snapshot belongs in the archive and must coexist with the tar.
rm -rf -- "$offline_source" "$offline_reference"

# Second pass captures uploads completed while content and SQLite were copied.
# Any rsync warning is a failed backup, not a partial success.
rsync -a --exclude='/.quarantine/' --exclude='/.incoming/' -- "$UPLOAD_DIR/" "$STAGE/khyeast/uploads/"
[[ ! -e $STAGE/khyeast/uploads/.quarantine ]] || fail 'quarantine exclusion failed'
[[ ! -e $STAGE/khyeast/uploads/.incoming ]] || fail 'incoming-upload exclusion failed'

commit=unknown
if [[ -e $RELEASE_DIR/.git ]]; then
  commit=$(git -C "$RELEASE_DIR" rev-parse HEAD 2>/dev/null || printf unknown)
fi
database_sha=$(sha256sum "$STAGE/khyeast/data/khyeast.db" | awk '{print $1}')
node - "$STAGE/khyeast/backup-manifest.json" "$STAMP" "$commit" "$database_sha" "$database_snapshot_mode" "$content_revision_value" <<'NODE'
const fs = require('node:fs');
const [file, createdAt, commit, databaseSha256, databaseSnapshotMode, contentRevision] = process.argv.slice(2);
fs.writeFileSync(file, JSON.stringify({
  format: 2,
  createdAt,
  commit,
  online: databaseSnapshotMode === 'online-sqlite-backup',
  databaseSnapshotMode,
  contentRevision: Number(contentRevision),
  quarantineExcluded: true,
  incomingUploadsExcluded: true,
  databaseSha256,
}, null, 2), { mode: 0o600 });
NODE

# Archive only the stable stage. Media is already compressed, so an
# uncompressed tar avoids a long CPU-heavy gzip window; encrypted offsite tools
# such as Restic can deduplicate and compress the result independently.
nice -n 10 ionice -c 3 tar --numeric-owner -C "$STAGE" -cf "$ARCHIVE_TMP" khyeast
list=$STAGE/archive.list
tar -tf "$ARCHIVE_TMP" >"$list"
grep -Fxq 'khyeast/data/khyeast.db' "$list" || fail 'archive is missing the SQLite snapshot'
grep -Fxq 'khyeast/backup-manifest.json' "$list" || fail 'archive is missing its manifest'
if grep -Fq '/.quarantine/' "$list"; then fail 'archive unexpectedly contains quarantine'; fi
if grep -Fq '/.incoming/' "$list"; then fail 'archive unexpectedly contains in-progress uploads'; fi

archive_hash=$(sha256sum "$ARCHIVE_TMP" | awk '{print $1}')
printf '%s  %s\n' "$archive_hash" "$(basename "$ARCHIVE")" >"$CHECKSUM_TMP"
# Flush complete temporary artifacts before exposing final names, then flush the
# publication directory. A sudden host loss cannot turn a logged success into a
# pair of durable names backed only by unwritten cache pages.
sync -f "$ARCHIVE_TMP"
sync -f "$CHECKSUM_TMP"
mv -- "$ARCHIVE_TMP" "$ARCHIVE"
mv -- "$CHECKSUM_TMP" "$CHECKSUM"
sync -f "$DEST"
printf 'backup-khyeast: created %s (%s bytes)\n' "$ARCHIVE" "$(stat -c %s "$ARCHIVE")"

# Bound local disk use only after a new archive is complete. Offsite storage
# needs its own independently verified retention; this local window is not a
# substitute for it.
retention_minutes=$(( LOCAL_RETENTION_DAYS * 24 * 60 ))
expired_list=$STAGE/expired-archives.list
find "$DEST" -maxdepth 1 -type f -name 'khyeast-*.tar' -mmin "+$retention_minutes" -print0 >"$expired_list"
while IFS= read -r -d '' expired; do
  rm -f -- "$expired" "$expired.sha256"
done <"$expired_list"
find "$DEST" -maxdepth 1 -type f -name 'khyeast-*.tar.sha256' -mmin "+$retention_minutes" -delete

printf 'backup-khyeast: local backup complete; encrypted offsite replication must verify this archive separately\n'
