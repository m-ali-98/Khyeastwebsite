# ==========================================================================
# Khuzestan Yeast Co. — Apache config (cPanel / shared hosting)
# SPA fallback + compression + caching tuned for slow Iranian connections.
# ==========================================================================

# --- Canonical URLs + route-aware SPA delivery -----------------------------
# The post-build SEO generator fills the marked block with every public page.
# Known routes receive their crawlable HTML while React still owns interaction;
# unknown routes receive a real HTTP 404 instead of a soft-404 index shell.
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical production host. Custom/staging hosts are deliberately untouched.
  RewriteCond %{HTTP_HOST} ^www\.khuzestanyeast-co\.com(?::\d+)?$ [NC]
  RewriteRule ^ https://khuzestanyeast-co.com%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^khuzestanyeast-co\.com(?::\d+)?$ [NC]
  RewriteRule ^ https://khuzestanyeast-co.com%{REQUEST_URI} [R=301,L,NE]

  RewriteRule ^(?:fa/)?index\.html/?$ / [R=301,L]

  # Legacy brand addresses are permanent, single-hop redirects. Optional
  # default-locale prefixes and trailing slashes collapse in the same response.
  RewriteRule ^(?:fa/)?dezmaye/?$ /products/dezmaye-gold-80 [R=301,L]
  RewriteRule ^(?:fa/)?shetab/?$ /products/shetab-90 [R=301,L]
  RewriteRule ^(?:fa/)?xpower/?$ /products/xpower-70 [R=301,L]
  RewriteRule ^(?:fa/)?nanmaye/?$ /products/nanmaye-10 [R=301,L]
  RewriteRule ^(en|ar)/dezmaye/?$ /$1/products/dezmaye-gold-80 [R=301,L]
  RewriteRule ^(en|ar)/shetab/?$ /$1/products/shetab-90 [R=301,L]
  RewriteRule ^(en|ar)/xpower/?$ /$1/products/xpower-70 [R=301,L]
  RewriteRule ^(en|ar)/nanmaye/?$ /$1/products/nanmaye-10 [R=301,L]

  RewriteRule ^fa/?$ / [R=301,L]
  RewriteRule ^fa/(.*?)/?$ /$1 [R=301,L,NE]
  RewriteRule ^(?:en|ar)(/admin(?:/.*?)?)/?$ $1 [R=301,L,NE]

  # One canonical, slashless URL for every page (real asset directories stay).
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

  # Never expose generated implementation files by their storage URL. Internal
  # rewrites retain the original route in THE_REQUEST and therefore stay valid;
  # the root-level ErrorDocument does not match this seo-pages-only rule.
  RewriteCond %{THE_REQUEST} "\s/+seo-pages(?:[/\s?])" [NC]
  RewriteRule ^seo-pages(?:/.*)?$ - [R=404,L,NC]

  # Private/transactional screens stay functional but always use a noindex
  # shell. Dynamic order codes cannot be enumerated at build time.
  RewriteRule ^admin(?:/.*)?$ /seo-pages/_private.html [L]
  RewriteRule ^shop/(?:cart|checkout|login|account)$ /seo-pages/_private.html [L]
  RewriteRule ^shop/order/[^/]+$ /seo-pages/_private.html [L]

  # SEO-PAGES:START
  # populated in dist/.htaccess by scripts/generate-seo.mjs
  # SEO-PAGES:END

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Root is dist/index.html. Everything else unknown is an actual 404 whose
  # ErrorDocument still boots React's localized NotFound screen.
  RewriteRule ^$ - [L]
  RewriteRule . - [R=404,L]
</IfModule>

# --- Compression (biggest win on slow links: ~70% off HTML/CSS/JS/JSON) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/rss+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

# Brotli when the host supports it (smaller than gzip)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# --- Caching --------------------------------------------------------------
# Some shared hosts still ship a mime.types without webp/avif; without this
# they are sent as application/octet-stream and the browser downloads them
# instead of rendering them.
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  # HTML must always be revalidated so new deploys are picked up
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Content-hashed build files never change → cache them hard
  <FilesMatch "\-[0-9a-zA-Z_\-]{8,}\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Brand and product artwork keeps a stable, unhashed filename, so it must
  # NOT be cached for a year: replacing the logo would stay invisible to every
  # returning visitor until their cache expired. A week plus
  # stale-while-revalidate paints instantly from cache and refreshes in the
  # background, so a new image appears on the next visit.
  <FilesMatch "\.(jpe?g|png|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>
  # Fonts are versioned by @fontsource and genuinely never change.
  <FilesMatch "\.woff2?$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Internal shells for private routes and ErrorDocument 404 carry the same
  # belt-and-braces index policy as the Node server, even if a crawler ignores
  # the equivalent HTML meta tag.
  <FilesMatch "^(_private|404)\.html$">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </FilesMatch>
  Header append Vary Accept-Encoding
</IfModule>

# --- MIME types ------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>

# --- Security headers ------------------------------------------------------
# The Node server sets these itself. They are repeated here because a static
# cPanel deploy (dist/ uploaded to public_html, no Node app) never runs that
# code, and would otherwise ship with no protection at all.
#
# NOTE: script-src uses 'unsafe-inline' here, unlike the Node server, which
# pins the sha256 of the inline boot script. Apache cannot compute that hash,
# and a wrong one blocks the script that sets language/direction/theme before
# first paint. If you run the Node server, its stricter policy applies instead.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self'; font-src 'self'; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Enable once HTTPS is confirmed working, otherwise the browser will refuse
  # plain HTTP for a year:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- Block access to sensitive files ---------------------------------------
# If the Node app is ever uploaded next to the static build, these must not be
# downloadable.
<FilesMatch "^\.env|\.db$|\.sqlite3?$|^\.git">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
