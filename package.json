{
  "name": "khyeastwebsite",
  "version": "1.0.0",
  "description": "Multi-page React website for Khuzestan Yeast Co. — crimson & white, RTL Persian, rich animations.",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev.mjs",
    "build": "vite build",
    "postbuild": "node scripts/generate-seo.mjs",
    "seo:generate": "node scripts/generate-seo.mjs",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "test": "npm run build && node scripts/test/run.mjs",
    "smoke": "npm run build && node scripts/test/run.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:all": "npm test && npm run test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-ali-98/Khyeastwebsite.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/m-ali-98/Khyeastwebsite/issues"
  },
  "homepage": "https://github.com/m-ali-98/Khyeastwebsite#readme",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "framer-motion": "^13.2.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.56.0",
    "multer": "^2.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "sharp": "^0.35.5",
    "smsir-js": "^1.3.3",
    "zarinpal-node-sdk": "^2.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.10.3",
    "sass": "^1.104.0",
    "vite": "^8.2.2"
  },
  "type": "module",
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
